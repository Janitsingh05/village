{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/complaint/(.*)",
      "destination": "/complaint/index.html"
    },
    {
      "source": "/admin/complaint/(.*)",
      "destination": "/admin/complaint/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
