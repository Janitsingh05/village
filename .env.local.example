# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill it in.
# Firebase is the only backend. Without these values the app shows a setup
# screen instead of starting — there is no local fallback, because a complaint
# the Panchayat cannot see is worse than an honest error.
# ---------------------------------------------------------------------------

# --- Pilot village (Phase 1 pins a single village) -------------------------
NEXT_PUBLIC_VILLAGE_ID=pilot-village
NEXT_PUBLIC_VILLAGE_NAME_HI=रामपुरा ग्राम पंचायत
NEXT_PUBLIC_VILLAGE_NAME_EN=Rampura Gram Panchayat
NEXT_PUBLIC_VILLAGE_DISTRICT_HI=ज़िला सीकर, राजस्थान
NEXT_PUBLIC_VILLAGE_DISTRICT_EN=Sikar District, Rajasthan
# Comma-separated ward / mohalla list shown in the report form
# English labels for the same wards, matched by position. Without these the
# Hindi names show in English mode too, which is the only untranslated text left.
NEXT_PUBLIC_WARDS_EN=Ward 1,Ward 2,Ward 3,Ward 4,Ward 5,Main Market,Near the School,Near the Temple
NEXT_PUBLIC_WARDS=वार्ड 1,वार्ड 2,वार्ड 3,वार्ड 4,वार्ड 5,मुख्य बाज़ार,स्कूल के पास,मंदिर के पास

# --- Firebase (Project settings -> Your apps -> Web app) -------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
