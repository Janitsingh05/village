{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "hosting-redirect",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://village-psi-eight.vercel.app/",
        "type": 302
      },
      {
        "source": "/:rest*",
        "destination": "https://village-psi-eight.vercel.app/:rest*",
        "type": 302
      }
    ]
  }
}
