rules_version = '2';

// GaonConnect — Phase 1 rules.
//
// Model: complaints are PUBLIC to read (that transparency is the whole point),
// citizens may CREATE but never modify, and only the village's own admins may
// change status. Everything is nested under villages/{villageId} so a second
// village can be added without touching these rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // An admin of THIS village. adminUserIds[] lives on the village doc, so a
    // Sarpanch can never touch another village's complaints.
    function isVillageAdmin(villageId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/villages/$(villageId))
        && request.auth.uid in get(/databases/$(database)/documents/villages/$(villageId)).data.adminUserIds;
    }

    // Whether the caller is the device that filed this complaint.
    //
    // Costs one document read per write, which is the price of not letting
    // strangers attach files and phone numbers to other people's reports. The
    // complaint document is written before anything hangs off it, so this
    // resolves — see createComplaint's ordering comment.
    function ownsComplaint(villageId, complaintId) {
      return exists(/databases/$(database)/documents/villages/$(villageId)/complaints/$(complaintId))
        && get(/databases/$(database)/documents/villages/$(villageId)/complaints/$(complaintId))
             .data.reporterUid == request.auth.uid;
    }

    // True when a write leaves every field except the listed ones untouched.
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    match /villages/{villageId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();

      // Nothing links itself here any more.
      //
      // There used to be a rule letting a signed-in phone append its own UID to
      // adminUserIds, because onboarding knew a number and the UID did not
      // exist until first sign-in. Registering before applying removed the gap:
      // the account exists first, the application carries its UID, and a super
      // admin writes it. One less way in, and revoking is a single write that
      // takes effect immediately instead of a number stripped from three lists.

      // The admin maintaining their own details. Narrow on purpose: this must
      // not become a way to edit the village itself or grant anyone access.
      // adminPhone belongs here because the profile screen edits it. It was
      // added to the client and to updateAdminProfile and never to this list,
      // so hasOnly() failed and *every* profile save was rejected — the one
      // screen an admin uses to put their own name in front of the village.
      allow update: if isVillageAdmin(villageId)
        && onlyChanged(['adminName', 'adminRole', 'adminPhone', 'adminPhotoUrl'])
        && request.resource.data.adminName.size() <= 80
        && request.resource.data.adminRole.size() <= 60
        && (request.resource.data.adminPhone == ''
            || request.resource.data.adminPhone.matches('^[6-9][0-9]{9}$'))
        && (request.resource.data.adminPhotoUrl == null
            || request.resource.data.adminPhotoUrl.size() < 60000);

      // Who administers this village, and the evidence a super admin recorded
      // when granting it.
      //
      // Not readable by the public, unlike everything else under a village:
      // these carry a reviewer's notes about somebody's identity documents.
      // What the app needs without privilege — the numbers, and the dates their
      // access ends — sits on the village document itself, where a date against
      // an already-public number gives nothing away.
      match /admins/{phone} {
        allow read, write: if isSuperAdmin();
      }

      match /complaints/{complaintId} {
        allow read: if true;

        // Filing requires an account, and the only account a citizen ever has is
        // the anonymous one the app creates for them without asking. They still
        // never see a login screen — but "nobody signs in" and "anybody may
        // write" are different things, and only the second was ever enforceable.
        //
        // What the UID buys: a complaint can only be edited by the device that
        // filed it, and a flood can be attributed to an account and cut off.
        // It is not a rate limit — rules cannot count over time without a
        // server — so App Check is still the thing to turn on next.
        allow create: if isSignedIn()
          && request.resource.data.reporterUid == request.auth.uid
          && request.resource.data.villageId == villageId
          && request.resource.data.status == 'pending'
          && request.resource.data.category is string
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          // The form's own cap, DESC_MAX in app/report/page.tsx. The comment
          // here used to claim they matched while the numbers were 200 and 300.
          && request.resource.data.description.size() <= 200
          && request.resource.data.reportedBy.phoneMasked is string
          && request.resource.data.reportedBy.phoneMasked.size() <= 14
          // Both objects are closed. description and location.address were
          // capped while the field beside them took anything up to the 1 MiB
          // document limit — including a real, unmasked phone number written
          // straight onto a world-readable document under any key at all.
          && request.resource.data.reportedBy.keys().hasOnly(['name', 'phoneMasked'])
          && request.resource.data.reportedBy.name.size() <= 60
          && request.resource.data.keys().hasOnly([
               'villageId', 'ref', 'category', 'description', 'photoUrl', 'photoCount',
               'voiceNote', 'location', 'status', 'reporterUid', 'reportedBy',
               'resolutionPhotoUrl', 'resolutionNote', 'feedback', 'timeline',
               'createdAt', 'updatedAt'
             ])
          && request.resource.data.resolutionPhotoUrl == null
          // Inline thumbnail only; the full image is its own document.
          && (request.resource.data.photoUrl == null
              || request.resource.data.photoUrl.size() < 60000)
          && request.resource.data.photoCount is int
          && request.resource.data.photoCount >= 0
          && request.resource.data.photoCount <= 3
          // The audio lives in its own document; only its length rides here,
          // bounded so the marker cannot outlive what the recorder will make.
          && (!('voiceNote' in request.resource.data.keys())
              || request.resource.data.voiceNote == null
              || (request.resource.data.voiceNote.seconds is int
                  && request.resource.data.voiceNote.seconds > 0
                  // MAX_VOICE_SECONDS in lib/voice-note.ts is 60. The rule
                  // allows a little more so a clip that ran slightly long is
                  // not thrown away over a rounding difference.
                  && request.resource.data.voiceNote.seconds <= 75))
          // Resolved from the reporter's coordinates; bounded so it cannot be
          // used to smuggle arbitrary text onto a public document.
          && (!('address' in request.resource.data.location.keys())
              || request.resource.data.location.address.size() <= 200);

        // Only the village's admins move a complaint along, and only these five
        // fields move.
        //
        // The old version pinned four fields the admin must not change and left
        // everything else open, which is the wrong way round: it permitted the
        // office being complained about to set the citizen's own verdict to
        // "confirmed fixed", blank photoUrl to strip the evidence out of the
        // public feed without deleting the complaint, rewrite the timeline that
        // records how long a repair took, and move createdAt to improve its own
        // average. An allow-list cannot drift like that — a new field is
        // forbidden until someone names it here.
        allow update: if isVillageAdmin(villageId)
          && onlyChanged(['status', 'updatedAt', 'timeline', 'resolutionNote', 'resolutionPhotoUrl'])
          && request.resource.data.status in ['pending', 'in_progress', 'resolved', 'closed']
          && (request.resource.data.resolutionPhotoUrl == null
              || request.resource.data.resolutionPhotoUrl.size() < 60000);

        // The reporter confirms the fix, or says it is still broken.
        //
        // Restricted to the device that filed it. This used to accept any
        // anonymous caller on any complaint, which meant the single signal a
        // villager has that a repair really happened could be flipped from a
        // browser console — by the office being complained about, among others.
        allow update: if isSignedIn()
          && resource.data.reporterUid == request.auth.uid
          && onlyChanged(['feedback', 'updatedAt'])
          && request.resource.data.feedback.verdict in ['still_open', 'confirmed'];

        // Deleting is the super admin's, not the Sarpanch's.
        //
        // A village admin can move a complaint through its statuses and add
        // proof, and that is the whole of their power over it — the point of a
        // public feed is that the office being complained about cannot make a
        // complaint disappear. Clearing a pilot's test data is a different job,
        // done by whoever runs the platform.
        allow delete: if isSuperAdmin();

        // The reporter's real phone number.
        //
        // The complaint above is world-readable and has to stay that way — a
        // public feed the village can inspect is the whole point. But a name, a
        // phone number and a house location published together is a safety
        // problem, so the number lives here instead, where exactly the people
        // who need to ring back can read it and nobody else can.
        match /private/contact {
          allow read: if isVillageAdmin(villageId) || isSuperAdmin();
          // Only the reporter, and only for their own complaint. Complaint ids
          // are public and a complaint filed without a number has no contact
          // document, so without this anyone could plant a valid-looking number
          // on somebody else's report — and `update: if false` means the
          // Panchayat would ring that stranger forever.
          allow create: if isSignedIn()
            && ownsComplaint(villageId, complaintId)
            && request.resource.data.phone is string
            && request.resource.data.phone.matches('^[6-9][0-9]{9}$');
          allow update: if false;
          allow delete: if isSuperAdmin();
        }

        // Full-size images live here, one document each, because Cloud Storage
        // needs a billing account and a village pilot should not. The size cap
        // keeps a write from failing against Firestore's 1 MiB document limit.
        match /media/{kind} {
          allow read: if true;
          // photo-0 .. photo-2 and 'voice' come from the citizen filing the
          // complaint; 'proof' is the admin's evidence and only they may write
          // it. A spoken complaint is public exactly like a written one — the
          // whole point is that the village can see what was reported.
          // isSignedIn() alone was satisfied by the anonymous account every
          // visitor gets, so this path was open in practice: any caller could
          // write unlimited 900 KB documents under any complaint id, existing
          // or invented. Ownership is the check that was missing.
          allow create: if isSignedIn()
            && request.resource.data.data is string
            && request.resource.data.data.size() < 900000
            && (
              isVillageAdmin(villageId)
              || ((kind.matches('^photo-[0-2]$') || kind == 'voice' || kind == 'transcript')
                  && ownsComplaint(villageId, complaintId))
            );
          allow update: if isVillageAdmin(villageId);
          // Deleted alongside the complaint they belong to; Firestore will not
          // remove a subcollection with its parent, so these have to go first
          // or the photos and recording outlive the complaint invisibly.
          allow delete: if isSuperAdmin();
        }
      }

      // Announcements: public to read, this village's admins to write.
      match /announcements/{announcementId} {
        allow read: if true;
        allow create, update: if isVillageAdmin(villageId)
          && request.resource.data.villageId == villageId
          && request.resource.data.kind in ['general', 'urgent']
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.body.size() <= 500
          // The poster thumbnail rides inline on this document.
          && (!('photoUrl' in request.resource.data.keys())
              || request.resource.data.photoUrl == null
              || request.resource.data.photoUrl.size() < 60000)
          && request.resource.data.keys().hasOnly([
               'villageId', 'kind', 'title', 'body', 'photoUrl', 'postedBy', 'createdAt'
             ]);
        allow delete: if isVillageAdmin(villageId);
      }
    }

    // Requests to administer a village.
    //
    // Anyone may file one, because a new Sarpanch has no account yet — but
    // filing it grants nothing. Only a super admin can read these (they carry
    // phone numbers), and only their approval puts a number on a village.
    match /adminRequests/{requestId} {
      allow read, update, delete: if isSuperAdmin();

      allow create: if request.resource.data.status == 'pending'
        // The village must actually exist, so a request cannot name a
        // village into being.
        && exists(/databases/$(database)/documents/villages/$(request.resource.data.villageId))
        // An application belongs to the account that filed it, and nobody can
        // file one on somebody else's behalf. This is what makes approval a
        // single write: the UID here is the UID that gets access.
        && isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 10
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.role.size() <= 60
        && request.resource.data.villageName.size() <= 120
        && request.resource.data.keys().hasOnly([
             'villageId', 'villageName', 'uid', 'email', 'name', 'phone', 'role',
             'idProofUrl', 'postProofUrl', 'status', 'createdAt', 'decidedAt',
             'decidedBy', 'verifiedVia', 'verifiedNote', 'termEndsAt'
           ])
        // A request without evidence is just a name, and a super admin has no
        // way to check a name. Both thumbnails are required here; the full
        // images go in the media subcollection below.
        // Thumbnails may be absent. An Aadhaar card or a letterhead is dense,
        // text-heavy and the hardest thing to squeeze under the inline budget —
        // requiring one here rejected exactly the applications that carried the
        // best evidence. The full images in the media subcollection are what a
        // super admin actually reviews; these only speed up the list.
        && (request.resource.data.idProofUrl == null
            || request.resource.data.idProofUrl.size() < 60000)
        && (request.resource.data.postProofUrl == null
            || request.resource.data.postProofUrl.size() < 60000)
        // Nobody gets to file their own approval.
        && request.resource.data.decidedAt == null
        && request.resource.data.decidedBy == ''
        && request.resource.data.verifiedVia == null
        && request.resource.data.termEndsAt == null;

      // Photographed identity documents. Written by the applicant while filing,
      // read by nobody but a super admin, and never editable afterwards — an
      // approval must rest on the images that were actually reviewed.
      match /media/{kind} {
        allow read: if isSuperAdmin();
        // Missed when the other create rules were tightened, and it was the
        // worst one to miss: no sign-in, no ownership, and both the request id
        // and the kind chosen by the caller — an open endpoint for unlimited
        // 900 KB documents. The application is written before its media, so the
        // parent is there to check against.
        allow create: if isSignedIn()
          && kind in ['id-proof', 'post-proof']
          && exists(/databases/$(database)/documents/adminRequests/$(requestId))
          && get(/databases/$(database)/documents/adminRequests/$(requestId)).data.uid == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
        allow update: if false;
        allow delete: if isSuperAdmin();
      }
    }

    // Residents disputing who is shown as their village's Sarpanch.
    //
    // Anonymous on purpose: contradicting the person who runs your village
    // should not require naming yourself. Same trust model as complaints —
    // anyone may file, nobody but a super admin may read or resolve.
    match /adminReports/{reportId} {
      allow read, update, delete: if isSuperAdmin();

      // Still anonymous in the sense that matters — no name, no number is stored
      // and the super admin cannot tell who wrote it. The account is only there
      // so an abusive flood can be cut off.
      allow create: if isSignedIn()
        && request.resource.data.status == 'open'
        && exists(/databases/$(database)/documents/villages/$(request.resource.data.villageId))
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.aboutName.size() <= 80
        && request.resource.data.villageName.size() <= 120
        // Anyone with an anonymous account can write one of these, so the shape
        // has to be closed or arbitrary fields ride along on a document a super
        // admin will open and read.
        && request.resource.data.keys().hasOnly([
             'villageId', 'villageName', 'aboutName', 'reason', 'status', 'createdAt'
           ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }
  }
}
